{
  "name": "@ilyagulya/t3-import",
  "version": "0.5.0-native.12",
  "description": "Import Codex, Claude Code and Oh My Pi history using native readers and T3 orchestration",
  "keywords": [
    "claude-code",
    "codex",
    "conversation",
    "importer",
    "oh-my-pi",
    "t3code"
  ],
  "homepage": "https://github.com/IlyaGulya/t3-import#readme",
  "bugs": {
    "url": "https://github.com/IlyaGulya/t3-import/issues"
  },
  "license": "MIT",
  "author": {
    "name": "CarlosGtrz",
    "url": "https://github.com/CarlosGtrz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaGulya/t3-import.git"
  },
  "bin": {
    "t3-import": "dist/cli.js",
    "t3-import-omp": "dist/omp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-native.mjs",
    "dev": "node dist/cli.js",
    "test": "node scripts/test-native.mjs",
    "typecheck": "node scripts/typecheck-native.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "release:check": "npm publish --dry-run --access public --tag latest",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "node scripts/lint.mjs",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "test:quality": "node --test scripts/quality.test.mjs",
    "typecheck:quality": "tsc --noEmit --strict --target ES2023 --module NodeNext --allowImportingTsExtensions --skipLibCheck quality/index.ts",
    "verify": "node scripts/verify.mjs",
    "verify:changed": "node scripts/verify.mjs --changed"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@effect/platform-node": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "commander": "^14.0.0",
    "diff": "8.0.3",
    "effect": "4.1.3",
    "mdast-util-directive": "3.1.0",
    "micromark-extension-directive": "4.0.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-decode-string": "2.0.1",
    "property-information": "7.2.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.12.4",
    "esbuild": "0.28.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=26"
  }
}
